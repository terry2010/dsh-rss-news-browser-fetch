{
  "name": "dsh-rss-news-browser-fetch",
  "version": "0.2.1",
  "description": "dsh plugin: browserFetch service — dedicated Chrome instance + CDP; run requests inside the user's real browser session (persistent cookies, same-origin fetch) as a compatibility fallback for sources that respond unreliably to Node fetch.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "web",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/terry2010/dsh-rss-news-browser-fetch.git"
  },
  "homepage": "https://github.com/terry2010/dsh-rss-news-browser-fetch#readme",
  "bugs": "https://github.com/terry2010/dsh-rss-news-browser-fetch/issues",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "cdp",
    "chrome-devtools-protocol",
    "chrome",
    "fetch",
    "web-scraping",
    "browser-automation",
    "headless-chrome",
    "crawler",
    "rss",
    "browser-session"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "author": "terry2010 <jstel@126.com>"
}
